{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2022",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "isolatedModules": true,
    "paths": {
      "@libs/*": ["libs/*/src/index.ts"],
      "@libs/api": ["libs/services/src/index.ts"],
      "@libs/service": ["libs/services/src/index.ts"],
      "@libs/store": ["libs/store/src/index.ts"],
      "services": ["libs/services/src/index.ts"]
    },
    "baseUrl": "."
  }
}
