{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "ui": ["libs/ui/src/index.ts"],
      "auth": ["libs/auth/src/index.ts"]
    },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  }
}
