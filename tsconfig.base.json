{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@libs/ui": ["libs/ui/src/index.ts"],
      "@libs/auth": ["libs/auth/src/index.ts"]
    },
    "composite": true,
    "declaration": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2022",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "isolatedModules": true
  }
}
